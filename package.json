{
  "name": "livetree",
  "version": "0.1.0",
  "description": "Switch a stable .livetree/src symlink between Git worktrees.",
  "type": "module",
  "bin": {
    "lt": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test --experimental-test-coverage $(find src -path '*/tests/*.test.mjs' -print)",
    "link": "npm run build && npm link"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fuzzysort": "^3.1.0",
    "yaml": "^2.9.0"
  }
}
