{
  "name": "livetree",
  "version": "0.2.0",
  "description": "Run parallel Git worktree dev servers behind stable local URLs and secure Tailscale sharing.",
  "type": "module",
  "bin": {
    "livetree": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build --config dashboard/vite.config.ts",
    "check": "tsc --noEmit && tsc --noEmit -p dashboard/tsconfig.json",
    "dashboard": "npm run build && node dist/cli.js server start --foreground",
    "dashboard:dev": "vite --config dashboard/vite.config.ts",
    "tauri": "tauri",
    "tauri:prepare": "npm run build && node scripts/prepare-tauri-sidecar.mjs",
    "tauri:prepare:dev": "node scripts/prepare-tauri-dev.mjs",
    "dev:mac": "tauri dev",
    "dev:ios": "tauri ios dev \"Avinoam’s iPhone\"",
    "app:dev": "tauri dev",
    "app:build": "tauri build --bundles app,dmg",
    "ios:init": "tauri ios init --skip-targets-install",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build",
    "test": "npm run build && node --test --experimental-test-coverage $(find src dashboard -path '*/tests/*.test.mjs' -print)",
    "link": "npm run build && npm link"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.4.3",
    "vite-plugin-solid": "^2.11.14"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-solid": "^1.33.0",
    "portless": "0.13.0",
    "solid-js": "^1.9.15",
    "yaml": "^2.9.0"
  }
}
