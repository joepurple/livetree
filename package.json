{
  "name": "livetree",
  "version": "0.2.0",
  "description": "Run parallel Git worktree dev servers behind stable local URLs and secure Tailscale sharing.",
  "type": "module",
  "bin": {
    "livetree": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build --config dashboard/vite.config.ts",
    "check": "tsc --noEmit && tsc --noEmit -p dashboard/tsconfig.json",
    "test": "npm run build && node --test --experimental-test-coverage $(find src -path '*/tests/*.test.mjs' -print)",
    "link": "npm run build && npm link"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.4.3",
    "vite-plugin-solid": "^2.11.14"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-solid": "^1.33.0",
    "portless": "0.13.0",
    "solid-js": "^1.9.15",
    "yaml": "^2.9.0"
  }
}
